<!DOCTYPE html>
<html lang="es">
<head>
    <title>Editar categorias</title>
    <%- include('./partials/head.ejs'); %>
</head>
<style>
</style>

<body>
    <%- include('./partials/navbar.ejs'); %>
    <div style="height: 75vh; display: flex; align-items: center; justify-content: center;">
        <div class="form">
            <form class="form-product category-sweet" method="POST" action="/categoria/editar/<%= categoria.id %>">
                <div class="mb-3">
                    <label class="form-label">Categoria</label>
                    <input class="form-control" type="text" placeholder="Introduzca el nombre de la categoria"
                        name="categoria" value="<%= categoria.categoria %>">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Enviar</button>
            </form>
        </div>
    </div>
    <script src="/javascripts/editcategory.js"></script>
</body>

</html>