<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias</title>
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css">
</head>
<style>
</style>

<body>
    <div style="height: 100vh; display: flex; align-items: center; justify-content: center;">
        <div class="form">
            <form class="form-product" method="POST" action="/categoria/editar/<%= categoria.id %>">
                <div class="mb-3">
                    <label class="form-label">Categoria</label>
                    <input class="form-control" type="text" placeholder="Introduzca el nombre de la categoria"
                        name="categoria" value="<%= categoria.categoria %>">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Enviar</button>
            </form>
        </div>
    </div>
</body>

</html>