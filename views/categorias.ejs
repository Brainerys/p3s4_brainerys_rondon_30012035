<!DOCTYPE html>
<html lang="es">

<head>
  <title>Categorias</title>
  <%- include('./partials/head.ejs'); %>
</head>
<style>
</style>
<%- include('./partials/navbar.ejs'); %>
<body>
  <% if (hasCategories) { %>
    <main class="products">
      <div class="form">
        <form class="form-product" method="POST" action="/categoria" id="categoria-form">
          <div class="mb-3">
            <label class="form-label">Categoria</label>
            <input class="form-control" type="text" placeholder="Introduzca el nombre de la categoria"
              name="categoria">
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">Enviar</button>
        </form>
      </div>
      <div class="cards">
        <% categorias.forEach(categoria=> { %>
          <div class="card" style="width: 18rem; height: 160px;">
            <div class="card-body" style="flex: 0;">
              <h5 class="card-title">
                <%= categoria.categoria %>
              </h5>
            </div>
            <div class="card-body">
              <a href="/categoria/editar/<%= categoria.id %>" class="btn btn-warning">Editar</a>
              <a data-id="<%= categoria.id %>" class="btn btn-danger delete-category">Eliminar</a>
            </div>
          </div>
          <% }) %>
      </div>
      <% } else { %>
      <div style="height: 75vh; display: flex; align-items: center; justify-content: center;">
        <div class="form">
          <form class="form-product" method="POST" action="/categoria" id="categoria-form">
            <div class="mb-3">
              <label class="form-label">Categoria</label>
              <input class="form-control" type="text" placeholder="Introduzca el nombre de la categoria"
                name="categoria" required>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Enviar</button>
          </form>
        </div>
      </div>
    </main>
    <% } %>
    <script src="/javascripts/categorias.js"></script>
</body>

</html>